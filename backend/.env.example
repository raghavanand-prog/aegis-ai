# ---------------------------------------------------------------------------
# AEGISX backend configuration (copy to .env and edit; never commit .env)
# ---------------------------------------------------------------------------

ENVIRONMENT=development
DEBUG=true

# PostgreSQL is the supported database for development and production.
# SQLite is only used by the automated test suite.
DATABASE_URL=postgresql+psycopg://aegisx:aegisx@localhost:5432/aegisx

# MUST be replaced with a long random value outside development.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Comma separated list of allowed browser origins for the SPA.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Telemetry -------------------------------------------------------------
# The synthetic generator produces clearly-fake security telemetry so the
# pipeline can be exercised safely. AEGISX never reaches out to a real
# production system unless an operator explicitly configures a collector.
TELEMETRY_ENABLED=true
TELEMETRY_INTERVAL_SECONDS=5
TELEMETRY_EVENTS_PER_TICK=1
TELEMETRY_ALLOW_EXTERNAL_SOURCES=false

# Require a valid JWT on the WebSocket stream.
WS_REQUIRE_AUTH=true

# --- Bootstrap analyst account --------------------------------------------
# Created on first start when the users table is empty. Change the password
# before exposing this instance to anyone else.
SEED_DEMO_USER=true
DEMO_USER_EMAIL=analyst@aegisx.dev
DEMO_USER_PASSWORD=AegisX!Demo123
DEMO_USER_NAME=Aegis Analyst

# ---------------------------------------------------------------------------
# V3: machine learning
# ---------------------------------------------------------------------------
# ML is an ADDITIONAL detection signal. With ML_ENABLED=false the platform runs
# on deterministic rules alone and every ML surface explains why it is empty.
ML_ENABLED=true
# Where trained artifacts are written and read. Not committed to git.
ML_MODEL_DIR=app/ml/artifacts
ML_CONTAMINATION=0.08
ML_RANDOM_STATE=1337
# Anomaly score at or above which an event is flagged. 0.65 is chosen from
# measurement: it flags ~1% of ordinary telemetry. See docs/ml-architecture.md.
ML_ANOMALY_THRESHOLD=0.65

# ---------------------------------------------------------------------------
# V3: event correlation
# ---------------------------------------------------------------------------
CORRELATION_ENABLED=true
CORRELATION_WINDOW_MINUTES=30
CORRELATION_MIN_EVENTS=3
# Sequences above this risk score raise a notification. They never become an
# incident on their own - promotion is always an analyst decision.
CORRELATION_INCIDENT_RISK=70

# ---------------------------------------------------------------------------
# V3: background enrichment
# ---------------------------------------------------------------------------
# Threat intelligence and correlation run off the ingestion path so neither can
# delay telemetry landing. The queue is bounded and drops rather than growing.
ENRICHMENT_ENABLED=true
ENRICHMENT_QUEUE_SIZE=2000

# ---------------------------------------------------------------------------
# V3: threat intelligence
# ---------------------------------------------------------------------------
# "none" disables outbound lookups entirely. The API key lives here on the
# server and is never exposed to the browser.
#
# Note: the synthetic telemetry generator uses RFC 5737 documentation ranges
# for "external" addresses, and those are deliberately never sent to a real
# provider. Enrichment therefore stays quiet on purely synthetic telemetry.
THREAT_INTEL_ENABLED=true
THREAT_INTEL_PROVIDER=none
VIRUSTOTAL_API_KEY=
THREAT_INTEL_TIMEOUT_SECONDS=6.0
THREAT_INTEL_CACHE_TTL_HOURS=24
THREAT_INTEL_DAILY_BUDGET=400

# ---------------------------------------------------------------------------
# V3: AI analyst
# ---------------------------------------------------------------------------
# "mock" is a deterministic, offline, evidence-grounded analyst that needs no
# key and no network. A hosted provider SENDS INCIDENT DETAIL (hostnames,
# usernames, addresses, command lines) to a third party - a deliberate operator
# decision, which is why it is not the default.
AI_ENABLED=true
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2000
AI_MAX_EVIDENCE_EVENTS=25
AI_DAILY_REQUEST_BUDGET=200
