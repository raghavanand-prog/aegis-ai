# ---------------------------------------------------------------------------
# Values used by infrastructure/docker-compose.yml. Copy to .env at the repo
# root and edit. Never commit the copy - .env is gitignored.
#
# Application configuration lives in backend/.env (see backend/.env.example);
# this file only parameterises the container stack.
# ---------------------------------------------------------------------------

POSTGRES_USER=aegisx
POSTGRES_PASSWORD=aegisx
POSTGRES_DB=aegisx
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=dev-only-insecure-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_FORMAT=json

# Bootstrap analyst account created on first start. Change the password before
# sharing the instance with anyone.
DEMO_USER_EMAIL=analyst@aegisx.dev
DEMO_USER_PASSWORD=AegisX!Demo123

# Baked into the frontend bundle at build time - must never hold a secret.
VITE_API_URL=http://localhost:8000/api/v1

# --- V3 -------------------------------------------------------------------
# Optional. Left empty the stack runs with deterministic rules plus the trained
# anomaly model, the offline AI analyst, and no external threat intelligence.
# A hosted AI provider sends incident detail outside this deployment.
AI_PROVIDER=mock
AI_API_KEY=
THREAT_INTEL_PROVIDER=none
VIRUSTOTAL_API_KEY=
